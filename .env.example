# KrishiRakshak Environment Variables Template
# Copy this file to .env and fill in your values.

# -------------------------------------
# Backend Config
# -------------------------------------
DATABASE_URL=sqlite:///./krishirakshak.db
SECRET_KEY=replace-this-with-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Outbreak Detection Configuration
OUTBREAK_TIME_WINDOW_DAYS=7
OUTBREAK_MIN_REPORTS=3
OUTBREAK_GEOHASH_PRECISION=5

# -------------------------------------
# ML Service Config
# -------------------------------------
MODEL_PATH=../models/best_model.pt
TREATMENTS_PATH=treatments.json
